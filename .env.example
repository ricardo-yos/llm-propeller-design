# ----------------------------------------------------------------------
# LLM Propeller Design — environment configuration
# ----------------------------------------------------------------------
# Default provider: Groq
# Set LLM_BASE_URL and LLM_AGENT_MODEL to select the provider and model.
# The corresponding API key is selected automatically by make_client().

LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_AGENT_MODEL=openai/gpt-oss-120b

# --- Alternative providers ---
# OpenAI:
# LLM_BASE_URL=
# LLM_AGENT_MODEL=gpt-5-mini

# Together AI:
# LLM_BASE_URL=https://api.together.xyz/v1
# LLM_AGENT_MODEL=your-model-name

# DeepSeek:
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_AGENT_MODEL=your-model-name

# Anthropic:
# LLM_BASE_URL=https://api.anthropic.com/v1/
# LLM_AGENT_MODEL=claude-sonnet-4-6

# OpenRouter:
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_AGENT_MODEL=provider/model-name

# --- API keys ---
# Fill in only the key for the provider you use.
# Never commit real API keys to version control.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
GOOGLE_API_KEY=
TOGETHER_API_KEY=
DEEPSEEK_API_KEY=
MANUS_API_KEY=
